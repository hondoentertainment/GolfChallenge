# Copy to .env.local for development. Set these in Vercel → Project → Settings → Environment Variables for production.

# Neon (or compatible) Postgres URL — required for app and scripts
DATABASE_URL=

# Strong secret for signing session JWTs — required in production; never commit real values
JWT_SECRET=

# Bearer token for secured cron routes — required on Vercel production (Authorization: Bearer …)
CRON_SECRET=

# Lowercase email of user to treat as admin when seed/migrations promote admins — optional locally
ADMIN_EMAIL=

# Resend API key for transactional email — optional unless sending mail
RESEND_API_KEY=

# Optional: comma-separated emails allowed on /admin/metrics-review (default: hondo4185@gmail.com; must be is_admin)
METRICS_REVIEW_ALLOWED_EMAILS=

# Optional: GitHub PAT for higher rate limits when loading CI status on metrics review page
GITHUB_TOKEN=

# Optional: sender address Resend recognizes for your domain
FROM_EMAIL=

# Optional: canonical site URL (invites, email links)
NEXT_PUBLIC_APP_URL=https://your-deployment.vercel.app
